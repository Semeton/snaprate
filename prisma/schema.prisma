generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  password                String
  role                    UserRole                 @default(REVIEWER)
  status                  AccountStatus            @default(PENDING)
  referralCode            String                   @unique @default(cuid())
  userIdentifier          String?                  @unique @default(cuid())
  referredBy              String?
  state                   State
  city                    String
  address                 String
  avatar                  String?
  dateOfBirth             DateTime?
  gender                  String?
  emailVerified           DateTime?
  phoneVerified           DateTime?
  isVerified              Boolean                  @default(false)
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  lastLoginAt             DateTime?
  accounts                Account[]
  adminActions            AdminAction[]            @relation("AdminActions")
  adminInvitations        AdminInvitation[]        @relation("AdminInvitations")
  agentApplications       AgentApplication[]
  agentProfile            Agent?
  businessInvitations     BusinessInvitation[]     @relation("BusinessInvitations")
  businessRecommendations BusinessRecommendation[] @relation("UserRecommendations")
  businessViews           BusinessView[]           @relation("UserBusinessViews")
  business                Business?
  commentVotes            CommentVote[]            @relation("CommentVoter")
  reportedContent         ReportedContent[]        @relation("UserReports")
  resolvedReports         ReportedContent[]        @relation("AdminResolutions")
  comments                ReviewComment[]          @relation("CommentAuthor")
  reviewVotes             ReviewVote[]             @relation("ReviewVoter")
  reviews                 Review[]
  rewardRedemptions       RewardRedemption[]
  rewards                 Reward[]                 @relation("ReferrerRewards")
  sessions                Session[]
  referredByUser          User?                    @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals               User[]                   @relation("UserReferrals")
  coupons                 Coupon[]                 @relation("UserCoupons")
  couponRedemptions       CouponRedemption[]
  couponFavorites         CouponFavorite[]         @relation("UserCouponFavorites")
  businessRegistrations   BusinessRegistration[]    @relation("AgentRegistrations")
  registeredBusinesses    Business[]                @relation("RegisteredBusinesses")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Business {
  id                    String                     @id @default(cuid())
  ownerId               String                     @unique
  name                  String
  description           String?
  category              BusinessCategory
  phone                 String
  email                 String
  website               String?
  logo                  String?
  coverImage            String?
  servicesImages        String[] // Array of service/product image URLs (max 3)
  address               String
  city                  String
  state                 State
  latitude              Float?
  longitude             Float?
  
  // New fields for dual status system
  reviewStatus          ReviewStatus @default(PENDING)
  addressVerificationStatus AddressVerificationStatus @default(UNVERIFIED)
  
  // Business verification status
  isVerified           Boolean @default(false)
  verificationSource   VerificationSource @default(RECOMMENDATION) // REGISTRATION, RECOMMENDATION
  registeredByAgentId  String?
  
  // Existing verification fields (will be migrated later)
  verificationStatus    BusinessVerificationStatus @default(PENDING)
  verificationDocuments String[]
  verificationNotes     String?
  verifiedAt            DateTime?
  cacNumber             String?
  utilityBill           String?
  
  averageRating         Float                      @default(0)
  totalReviews          Int                        @default(0)
  totalVisits           Int                        @default(0)
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  onboardedByAgentId    String?
  deletedAt             DateTime?
  
  // Relations
  analytics             BusinessAnalytics[]
  businessHours         BusinessHours[]
  businessSettings      BusinessSettings?
  views                 BusinessView[]
  verification          BusinessVerification?
  onboardedByAgent      Agent?                     @relation("OnboardedBusinesses", fields: [onboardedByAgentId], references: [id])
  registeredByAgent     User?                      @relation("RegisteredBusinesses", fields: [registeredByAgentId], references: [id])
  owner                 User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  coupons               Coupon[]
  reviews               Review[]
  businessRegistrations BusinessRegistration[]

  @@map("businesses")
}

model BusinessVerification {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Director/Authorized Signatory ID
  directorIdType        DirectorIdType
  directorIdNumber      String
  directorIdImage       String // URL to uploaded image
  
  // Business Documents
  cacDocumentType       CacDocumentType?
  cacDocumentImage      String? // URL to uploaded image
  firsTaxClearance      String? // URL to uploaded image
  
  // Address Verification
  addressEvidenceType   AddressEvidenceType?
  addressEvidenceImage  String? // URL to uploaded image
  
  // Verification Status
  verificationStatus    VerificationStatus @default(PENDING)
  adminNotes            String?
  reviewedBy            String?
  reviewedAt            DateTime?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@map("business_verifications")
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isOpen     Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model BusinessSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  emailNotifications  Boolean  @default(true)
  smsNotifications    Boolean  @default(false)
  reviewAlerts        Boolean  @default(true)
  couponRedemptions   Boolean  @default(true)
  weeklyReports       Boolean  @default(true)
  marketingUpdates    Boolean  @default(false)
  profileVisibility   String   @default("PUBLIC")
  showContactInfo     Boolean  @default(true)
  showRevenue         Boolean  @default(false)
  allowDirectMessages Boolean  @default(true)
  twoFactorAuth       Boolean  @default(false)
  sessionTimeout      Int      @default(30)
  loginNotifications  Boolean  @default(true)
  googleAnalytics     Boolean  @default(false)
  facebookPixel       Boolean  @default(false)
  mailchimp           Boolean  @default(false)
  zapier              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model Review {
  id                   String          @id @default(cuid())
  businessId           String
  reviewerId           String
  rating               Int
  content              String
  images               String[]
  video                String?
  status               ReviewStatus    @default(PENDING)
  isVerified           Boolean         @default(false)
  helpfulCount         Int             @default(0)
  businessResponse     String?
  businessResponseDate DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  isAnonymous          Boolean         @default(false)
  reportReason         String?
  reported             Boolean         @default(false)
  deletedAt            DateTime?
  comments             ReviewComment[]
  votes                ReviewVote[]
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewer             User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rewards              Reward[]

  @@map("reviews")
}

model ReviewComment {
  id         String          @id @default(cuid())
  reviewId   String
  authorId   String
  authorType String
  content    String
  parentId   String?
  isEdited   Boolean         @default(false)
  editedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  votes      CommentVote[]
  author     User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent     ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    ReviewComment[] @relation("CommentReplies")
  review     Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_comments")
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  voteType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation("ReviewVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

model CommentVote {
  id        String        @id @default(cuid())
  commentId String
  userId    String
  voteType  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  comment   ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation("CommentVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_votes")
}

model Coupon {
  id                 String             @id @default(cuid())
  businessId         String
  title              String
  description        String?
  baseCode           String?             @unique // Base 9-character code (K2X-PL7-YJ9)
  userSpecificCode  String?            @unique // Full code with user ID (K2X-PL7-YJ9-70BR)
  type               CouponType
  value              Float
  minimumOrderAmount Float?
  maximumDiscount    Float?
  validFrom          DateTime
  validUntil         DateTime
  maxUses            Int?
  totalIssued        Int                @default(0)
  totalRedeemed      Int                @default(0)
  status             CouponStatus       @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  currentUses        Int                @default(0)
  deletedAt          DateTime?
  
  // New fields for advanced restrictions
  useType            CouponUseType      @default(SINGLE_USE)
  allowedDaysOfWeek  Int[]             @default([]) // 0=Sunday, 1=Monday, etc.
  allowedTimeStart   String?           // Format: "HH:MM" (24-hour)
  allowedTimeEnd     String?           // Format: "HH:MM" (24-hour)
  cannotCombineWithOtherCoupons Boolean @default(true)
  requiresIdVerification Boolean        @default(false)
  maxUsesPerUser     Int?              @default(1)
  
  // User assignment tracking
  assignedUserId     String?            // The user this coupon is assigned to
  assignedAt         DateTime?
  
  // Relations
  redemptions        CouponRedemption[]
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedUser       User?              @relation("UserCoupons", fields: [assignedUserId], references: [id])
  favorites          CouponFavorite[]   @relation("CouponFavorites")

  @@map("coupons")
}

model CouponRedemption {
  id              String    @id @default(cuid())
  couponId        String
  userId          String
  redeemedAt      DateTime  @default(now())
  orderAmount     Float?
  discountApplied Float
  redemptionMethod RedemptionMethod @default(IN_PERSON)
  staffNotes      String?
  idVerified      Boolean   @default(false)
  verificationCode String?  // For online verification
  deletedAt       DateTime?
  coupon          Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coupon_redemptions")
}

model CouponFavorite {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserCouponFavorites", fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation("CouponFavorites", fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@map("coupon_favorites")
}

model Agent {
  id                        String     @id @default(cuid())
  userId                    String     @unique
  businessName              String?
  businessAddress           String?
  businessPhone             String?
  businessEmail             String?
  bankName                  String?
  accountNumber             String?
  accountName               String?
  totalBusinesses           Int        @default(0)
  totalEarnings             Float      @default(0)
  registeredBusinessesCount Int        @default(0)
  verifiedBusinessesCount   Int        @default(0)
  isApproved                Boolean    @default(false)
  approvedAt                DateTime?
  approvedBy                String?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  deletedAt                 DateTime?
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardedBusinesses        Business[] @relation("OnboardedBusinesses")

  @@map("agents")
}

model Reward {
  id          String    @id @default(cuid())
  referrerId  String
  amount      Float
  type        String
  description String
  isRedeemed  Boolean   @default(false)
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
  reviewId    String?
  referrer    User      @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  review      Review?   @relation(fields: [reviewId], references: [id])

  @@map("rewards")
}

model RewardRedemption {
  id          String    @id @default(cuid())
  userId      String
  type        String
  amount      Float
  phone       String?
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reward_redemptions")
}

model BusinessAnalytics {
  id                String   @id @default(cuid())
  businessId        String
  date              DateTime
  visits            Int      @default(0)
  uniqueVisitors    Int      @default(0)
  pageViews         Int      @default(0)
  reviews           Int      @default(0)
  averageRating     Float    @default(0)
  couponViews       Int      @default(0)
  couponRedemptions Int      @default(0)
  revenue           Float    @default(0)
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("business_analytics")
}

model BusinessView {
  id         String   @id @default(cuid())
  businessId String
  viewerId   String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  source     String   @default("DIRECT")
  viewType   String   @default("PROFILE")
  sessionId  String?
  duration   Int?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  viewer     User?    @relation("UserBusinessViews", fields: [viewerId], references: [id])

  @@index([businessId, createdAt])
  @@index([viewerId, createdAt])
  @@index([source, createdAt])
  @@map("business_views")
}

model BusinessRecommendation {
  id                  String           @id @default(cuid())
  businessName        String
  recommendedBy       String
  status              String           @default("PENDING")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  additionalNotes     String?
  adminNotes          String?
  businessAddress     String
  businessCategory    BusinessCategory
  businessCity        String
  businessDescription String?
  businessEmail       String?
  businessPhone       String?
  businessState       State
  businessWebsite     String?
  ownerAddress        String?
  ownerCity           String?
  ownerEmail          String
  ownerName           String
  ownerPhone          String
  ownerState          String?
  reviewedAt          DateTime?
  reviewedBy          String?
  recommendedByUser   User             @relation("UserRecommendations", fields: [recommendedBy], references: [id], onDelete: Cascade)

  @@map("business_recommendations")
}

model AgentApplication {
  id                String    @id @default(cuid())
  userId            String
  motivation        String
  experience        String
  businessKnowledge String
  commitment        String
  
  // ID Verification Fields
  idDocumentType    String?   // VOTER_CARD, NATIONAL_ID, PASSPORT, DRIVERS_LICENSE
  idDocumentNumber  String?
  idDocumentImage   String?
  idVerified        Boolean   @default(false)
  idVerifiedAt      DateTime?
  idVerifiedBy      String?
  
  // Business Registration Tracking
  registeredBusinessesCount Int @default(0)
  verifiedBusinessesCount   Int @default(0)
  
  status            String    @default("PENDING") // PENDING, ID_VERIFIED, APPROVED, REJECTED
  adminNotes        String?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_applications")
}

model BusinessRegistration {
  id                String    @id @default(cuid())
  agentId           String
  businessId        String?
  registrationType  RegistrationType // FULL_REGISTRATION, RECOMMENDATION
  status            RegistrationStatus @default(PENDING) // PENDING, VERIFIED, REJECTED
  submittedAt       DateTime  @default(now())
  verifiedAt        DateTime?
  verifiedBy        String?
  adminNotes        String?
  
  // For full registration - complete business details
  businessName      String?
  businessDescription String?
  businessCategory  BusinessCategory?
  businessPhone     String?
  businessEmail     String?
  businessAddress   String?
  businessCity      String?
  businessState     State?
  businessWebsite   String?
  
  // For verification documents (full registration only)
  directorIdType    DirectorIdType?
  directorIdNumber  String?
  directorIdImage   String?
  cacDocumentType   CacDocumentType?
  cacDocumentImage  String?
  firsTaxClearance  String?
  addressEvidenceType AddressEvidenceType?
  addressEvidenceImage String?
  
  // Owner information (required for all registrations)
  ownerName         String?
  ownerEmail        String?
  ownerPhone        String?
  ownerAddress      String?
  ownerCity         String?
  ownerState        State?
  
  agent             User      @relation("AgentRegistrations", fields: [agentId], references: [id], onDelete: Cascade)
  business          Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@unique([agentId, businessId])
  @@map("business_registrations")
}

model PlatformSettings {
  id                                 String   @id
  minimumRedemptionAmount            Int      @default(5000)
  reviewRewardAmount                 Int      @default(50)
  referralRewardAmount               Int      @default(20)
  businessRecommendationRewardAmount Int      @default(100)
  businessRegistrationRewardRate     Int      @default(100)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt
  minimumBusinessesForAgent          Int      @default(5)

  @@map("platform_settings")
}

model AdminInvitation {
  id              String           @id @default(cuid())
  email           String           @unique
  role            UserRole
  invitedBy       String
  invitationToken String           @unique
  expiresAt       DateTime
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  invitedByUser   User             @relation("AdminInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("admin_invitations")
}

model BusinessInvitation {
  id              String           @id @default(cuid())
  email           String           @unique
  businessName    String
  invitationToken String           @unique
  expiresAt       DateTime
  status          InvitationStatus @default(PENDING)
  invitedBy       String
  createdAt       DateTime         @default(now())
  invitedByUser   User             @relation("BusinessInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("business_invitations")
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())
  adminName  String?
  ipAddress  String?
  admin      User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_actions")
}

model ReportedContent {
  id          String       @id @default(cuid())
  contentType ContentType
  contentId   String
  reporterId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reporter    User         @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver    User?        @relation("AdminResolutions", fields: [resolvedBy], references: [id])

  @@map("reported_content")
}

enum UserRole {
  REVIEWER
  BUSINESS_OWNER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum State {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  FCT
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
}

enum BusinessCategory {
  RESTAURANT
  RETAIL
  HEALTHCARE
  EDUCATION
  ENTERTAINMENT
  TECHNOLOGY
  FINANCE
  REAL_ESTATE
  AUTOMOTIVE
  BEAUTY
  FITNESS
  TRAVEL
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  FLAGGED
  SUSPENDED
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  USED
  DELETED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponUseType {
  SINGLE_USE
  MULTI_USE
  ONCE_PER_USER
}

enum RedemptionMethod {
  IN_PERSON
  ONLINE
  QR_CODE
}

enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ContentType {
  REVIEW
  BUSINESS
  USER
}

enum ReportReason {
  INAPPROPRIATE_CONTENT
  SPAM
  HARASSMENT
  FALSE_INFORMATION
  COPYRIGHT_VIOLATION
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATED
  RESOLVED
  DISMISSED
}

enum AddressVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum DirectorIdType {
  NATIONAL_ID
  INTERNATIONAL_PASSPORT
  DRIVERS_LICENSE
  VOTER_CARD
}

enum CacDocumentType {
  CAC_CERTIFICATE_OF_INCORPORATION
  CAC_STATUS_REPORT
  CAC_BUSINESS_NAME_REGISTRATION
}

enum AddressEvidenceType {
  UTILITY_BILL
  LEASE_AGREEMENT
  SIGNAGE_PHOTO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum RegistrationType {
  FULL_REGISTRATION
  RECOMMENDATION
}

enum RegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationSource {
  REGISTRATION
  RECOMMENDATION
}
